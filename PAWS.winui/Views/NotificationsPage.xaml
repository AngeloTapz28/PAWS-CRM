<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PAWS.winui.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PawsComboBox}"/>
    </Page.Resources>

    <Grid Background="{StaticResource PawsBackgroundBrush}" Padding="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid x:Name="HeaderPanel" Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="SYSTEM" Style="{StaticResource PawsOverline}"/>
                <TextBlock Text="Notifications" Style="{StaticResource PawsPageTitle}"/>
                <TextBlock x:Name="SummaryText" Text=" " Style="{StaticResource PawsCaption}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"/>
                <Button x:Name="RefreshButton" Style="{StaticResource PawsSecondaryButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MarkAllReadButton" Style="{StaticResource PawsPrimaryButton}" Click="MarkAllRead_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                        <TextBlock Text="Mark All as Read"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= TOOLBAR ================= -->
        <Border x:Name="ToolbarCard" Grid.Row="1" Style="{StaticResource PawsCard}" Padding="16" Margin="0,20,0,0">
            <ComboBox x:Name="FilterBox" Header="Show" Width="220" HorizontalAlignment="Left"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All Notifications"/>
                <ComboBoxItem Content="Unread only"/>
            </ComboBox>
        </Border>

        <!-- ================= MESSAGES ================= -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <!-- ================= EMPTY STATE + NOTIFICATIONS ================= -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel Spacing="12" Padding="0,8,0,32">

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            Spacing="10" HorizontalAlignment="Center" Margin="0,48,0,0">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="16"/>
                        </TransitionCollection>
                    </StackPanel.Transitions>
                    <Image Source="ms-appx:///Assets/paws-icon.png" Width="72" Height="72" Opacity="0.35"/>
                    <TextBlock x:Name="EmptyTitleText" Text="No notifications yet"
                               Style="{StaticResource PawsSectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHintText" Text=" "
                               Style="{StaticResource PawsCaption}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Grid x:Name="ListHost">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.2"/>
                    </Grid.OpacityTransition>

                    <ItemsControl x:Name="NotificationsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CardBackground}"
                                        BorderBrush="{StaticResource PawsBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="18,16"
                                        Margin="0,0,0,12"
                                        Loaded="Card_Loaded"
                                        PointerEntered="Card_PointerEntered"
                                        PointerExited="Card_PointerExited">
                                    <Border.BackgroundTransition>
                                        <BrushTransition Duration="0:0:0.15"/>
                                    </Border.BackgroundTransition>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Type icon -->
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12"
                                                Background="{Binding IconTileBackground}"
                                                VerticalAlignment="Top">
                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="18"
                                                      Foreground="{Binding IconForeground}"/>
                                        </Border>

                                        <!-- Text -->
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Source.Title}"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{StaticResource PawsPrimaryBrush}"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding MarkReadVisibility}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Source.Message}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TimeText}"
                                                       Style="{StaticResource PawsCaption}"/>
                                        </StackPanel>

                                        <!-- Action -->
                                        <Button Grid.Column="2" Content="Mark as read"
                                                Style="{StaticResource PawsSecondaryButton}"
                                                MinHeight="32" Padding="12,4" FontSize="12"
                                                VerticalAlignment="Top"
                                                Click="MarkRead_Click" Tag="{Binding}"
                                                Visibility="{Binding MarkReadVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>