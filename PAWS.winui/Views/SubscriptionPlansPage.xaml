<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PAWS.winui.Views.SubscriptionPlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PawsTextBox}"/>
    </Page.Resources>

    <Grid Background="{StaticResource PawsBackgroundBrush}" Padding="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid x:Name="HeaderPanel" Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="PLATFORM" Style="{StaticResource PawsOverline}"/>
                <TextBlock Text="Subscription Plans" Style="{StaticResource PawsPageTitle}"/>
                <TextBlock Text="Create and edit the plans companies can subscribe to, including price, branch limit and terms."
                           Style="{StaticResource PawsCaption}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"/>
                <Button Style="{StaticResource PawsSecondaryButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PawsPrimaryButton}" Click="AddPlan_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Add Plan"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= MESSAGES ================= -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <!-- ================= TABLE ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel Spacing="16" Padding="0,8,0,32">

                <Border x:Name="TableCard" Style="{StaticResource PawsCard}" Padding="0,0,0,8">
                    <StackPanel>
                        <StackPanel Padding="24,20,24,14" Spacing="2">
                            <TextBlock Text="All Plans" Style="{StaticResource PawsSectionTitle}"/>
                            <TextBlock x:Name="TotalText" Text=" " Style="{StaticResource PawsCaption}"/>
                        </StackPanel>

                        <ScrollViewer x:Name="TableScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Disabled"
                                      SizeChanged="TableScroll_SizeChanged">
                            <Grid x:Name="TableGrid" MinWidth="900">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row -->
                                <Grid Grid.Row="0" Padding="24,10"
                                      Background="{StaticResource PawsBackgroundBrush}"
                                      BorderBrush="{StaticResource PawsBorderBrush}"
                                      BorderThickness="0,1,0,1"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PLAN" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="1" Text="PRICE / MONTH" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="2" Text="BRANCH LIMIT" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="3" Text="COMPANIES" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="5" Text="ACTION" Style="{StaticResource PawsOverline}" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Data rows -->
                                <ItemsControl Grid.Row="1" x:Name="PlansList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="24,14"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource PawsBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Loaded="Row_Loaded"
                                                    PointerEntered="Row_PointerEntered"
                                                    PointerExited="Row_PointerExited">
                                                <Grid ColumnSpacing="12">
                                                    <!-- These widths MUST match the header row above -->
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="220"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- PLAN -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                                                VerticalAlignment="Center">
                                                        <Border Width="32" Height="32" CornerRadius="16"
                                                                Background="{StaticResource PawsPrimarySoftBrush}">
                                                            <FontIcon Glyph="&#xE8C7;" FontSize="14"
                                                                      Foreground="{StaticResource PawsPrimaryBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding NameText}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding PriceText}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2" Text="{Binding LimitText}"
                                                               FontSize="14"
                                                               Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="3" Text="{Binding CompaniesText}"
                                                               FontSize="14"
                                                               Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <!-- STATUS -->
                                                    <Border Grid.Column="4"
                                                            Style="{StaticResource PawsBadgeBase}"
                                                            Background="{Binding StatusBadgeBackground}">
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   Style="{StaticResource PawsBadgeTextBase}"
                                                                   Foreground="{Binding StatusBadgeForeground}"/>
                                                    </Border>

                                                    <!-- ACTIONS -->
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="Edit"
                                                                Style="{StaticResource PawsSecondaryButton}"
                                                                MinHeight="32" Padding="12,4" FontSize="12"
                                                                Click="EditPlan_Click" Tag="{Binding}"/>
                                                        <Button Content="Deactivate"
                                                                Style="{StaticResource PawsGhostButton}"
                                                                Foreground="{StaticResource PawsErrorBrush}"
                                                                MinHeight="32" Padding="10,4" FontSize="12"
                                                                Click="DeactivatePlan_Click" Tag="{Binding}"
                                                                Visibility="{Binding DeactivateVisibility}"/>
                                                        <Button Content="Activate"
                                                                Style="{StaticResource PawsGhostButton}"
                                                                Foreground="{StaticResource PawsSuccessBrush}"
                                                                MinHeight="32" Padding="10,4" FontSize="12"
                                                                Click="ActivatePlan_Click" Tag="{Binding}"
                                                                Visibility="{Binding ActivateVisibility}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== FORM POPUP (shown/hidden from code) ===== -->
        <Grid x:Name="FormOverlay"
              Grid.RowSpan="3"
              Margin="-32,-28,-32,0"
              Background="#8C1F2A44"
              Visibility="Collapsed">

            <Border x:Name="FormPanel"
                    Style="{StaticResource PawsCard}" Padding="24"
                    MaxWidth="600" Margin="24,48,24,24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,0,12,0">
                        <TextBlock x:Name="FormTitle" Text="Add Plan" Style="{StaticResource PawsSectionTitle}"/>

                        <TextBox x:Name="NameBox" Header="Plan name"/>
                        <TextBox x:Name="PriceBox" Header="Price per month (PHP)" PlaceholderText="e.g. 499"/>

                        <StackPanel Spacing="6">
                            <TextBox x:Name="LimitBox" Header="Branch limit" PlaceholderText="e.g. 3"/>
                            <CheckBox x:Name="UnlimitedBox" Content="Unlimited branches"
                                      Checked="Unlimited_Changed" Unchecked="Unlimited_Changed"/>
                        </StackPanel>

                        <TextBox x:Name="TermsBox" Header="Terms and conditions"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="160"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="Save" Style="{StaticResource PawsPrimaryButton}" Click="Save_Click"/>
                            <Button Content="Cancel" Style="{StaticResource PawsSecondaryButton}" Click="CancelForm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Error bar shown inside the popup -->
            <InfoBar x:Name="PopupErrorBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Center"
                     MaxWidth="600"
                     Margin="24,24,24,0"/>
        </Grid>
    </Grid>
</Page>