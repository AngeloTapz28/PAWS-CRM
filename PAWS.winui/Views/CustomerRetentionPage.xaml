<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PAWS.winui.Views.CustomerRetentionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PawsTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PawsComboBox}"/>

        <Style x:Key="StatIconTile" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PawsBackgroundBrush}" Padding="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid x:Name="HeaderPanel" Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="OPERATIONS" Style="{StaticResource PawsOverline}"/>
                <TextBlock Text="Customer Retention" Style="{StaticResource PawsPageTitle}"/>
                <TextBlock x:Name="SummaryText" Text=" " Style="{StaticResource PawsCaption}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"/>
                <Button Style="{StaticResource PawsSecondaryButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= STAT CARDS ================= -->
        <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,20,0,0">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" IsStaggeringEnabled="True"/>
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PawsCard}">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource StatIconTile}" Background="{StaticResource PawsErrorSoftBrush}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{StaticResource PawsErrorBrush}"/>
                    </Border>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="OverdueCountText" Text="0" Style="{StaticResource PawsStatNumber}"/>
                        <TextBlock Text="OVERDUE" Style="{StaticResource PawsOverline}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PawsCard}">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource StatIconTile}" Background="{StaticResource PawsWarningSoftBrush}">
                        <FontIcon Glyph="&#xE121;" FontSize="18" Foreground="{StaticResource PawsWarningBrush}"/>
                    </Border>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="DueSoonCountText" Text="0" Style="{StaticResource PawsStatNumber}"/>
                        <TextBlock Text="DUE SOON" Style="{StaticResource PawsOverline}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PawsCard}">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource StatIconTile}" Background="{StaticResource PawsSuccessSoftBrush}">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{StaticResource PawsSuccessBrush}"/>
                    </Border>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="OnTrackCountText" Text="0" Style="{StaticResource PawsStatNumber}"/>
                        <TextBlock Text="ON TRACK" Style="{StaticResource PawsOverline}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource PawsCard}">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource StatIconTile}" Background="{StaticResource PawsHoverSurfaceBrush}">
                        <FontIcon Glyph="&#xE787;" FontSize="18" Foreground="{StaticResource PawsTextSecondaryBrush}"/>
                    </Border>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="NotScheduledCountText" Text="0" Style="{StaticResource PawsStatNumber}"/>
                        <TextBlock Text="NOT SCHEDULED" Style="{StaticResource PawsOverline}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= TOOLBAR ================= -->
        <Border x:Name="ToolbarCard" Grid.Row="2" Style="{StaticResource PawsCard}" Padding="16" Margin="0,16,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" MinWidth="200">
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="Search by name or email..."
                             Padding="38,9,12,9"
                             TextChanged="Filter_Changed"/>
                    <FontIcon Glyph="&#xE721;" FontSize="14"
                              Foreground="{StaticResource PawsTextSecondaryBrush}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="14,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <ComboBox x:Name="StatusFilterBox" Grid.Column="1" Width="190" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All Statuses"/>
                    <ComboBoxItem Content="Overdue"/>
                    <ComboBoxItem Content="Due Soon"/>
                    <ComboBoxItem Content="On Track"/>
                    <ComboBoxItem Content="Not Scheduled"/>
                </ComboBox>

                <Button Grid.Column="2" Style="{StaticResource PawsGhostButton}"
                        Content="Reset" Click="ResetFilters_Click"/>
            </Grid>
        </Border>

        <!-- ================= MESSAGES ================= -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,16,0,0">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <!-- ================= EMPTY STATE + TABLE ================= -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel Spacing="16" Padding="0,8,0,32">

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            Spacing="10" HorizontalAlignment="Center" Margin="0,40,0,0">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="16"/>
                        </TransitionCollection>
                    </StackPanel.Transitions>
                    <Image Source="ms-appx:///Assets/paws-icon.png" Width="72" Height="72" Opacity="0.35"/>
                    <TextBlock x:Name="EmptyTitleText" Text="No customers found"
                               Style="{StaticResource PawsSectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHintText" Text=" "
                               Style="{StaticResource PawsCaption}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="TableCard" Style="{StaticResource PawsCard}" Padding="0,0,0,8">
                    <StackPanel>
                        <StackPanel Padding="24,20,24,14" Spacing="2">
                            <TextBlock Text="Customers" Style="{StaticResource PawsSectionTitle}"/>
                            <TextBlock x:Name="TotalText" Text=" " Style="{StaticResource PawsCaption}"/>
                        </StackPanel>

                        <ScrollViewer x:Name="TableScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Disabled"
                                      SizeChanged="TableScroll_SizeChanged">
                            <Grid x:Name="TableGrid" MinWidth="1200">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row -->
                                <Grid Grid.Row="0" Padding="24,10"
                                      Background="{StaticResource PawsBackgroundBrush}"
                                      BorderBrush="{StaticResource PawsBorderBrush}"
                                      BorderThickness="0,1,0,1"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CUSTOMER" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="2" Text="NEXT FOLLOW-UP" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="3" Text="NOTES" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="4" Text="LAST CONTACTED" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="5" Text="ACTION" Style="{StaticResource PawsOverline}" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Data rows -->
                                <Grid Grid.Row="1" x:Name="ListHost">
                                    <Grid.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.2"/>
                                    </Grid.OpacityTransition>

                                    <ItemsControl x:Name="CustomersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="24,14"
                                                        Background="Transparent"
                                                        BorderBrush="{StaticResource PawsBorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Loaded="Row_Loaded"
                                                        PointerEntered="Row_PointerEntered"
                                                        PointerExited="Row_PointerExited">
                                                    <Border.BackgroundTransition>
                                                        <BrushTransition Duration="0:0:0.12"/>
                                                    </Border.BackgroundTransition>

                                                    <Grid ColumnSpacing="12">
                                                        <!-- These widths MUST match the header row above -->
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="180"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- CUSTOMER -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                                                    VerticalAlignment="Center">
                                                            <Border Width="34" Height="34" CornerRadius="17"
                                                                    Background="{StaticResource PawsPrimarySoftBrush}">
                                                                <TextBlock Text="{Binding Initials}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource PawsPrimaryBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Text="{Binding NameText}"
                                                                           FontSize="14" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding EmailText}"
                                                                           Style="{StaticResource PawsCaption}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTipService.ToolTip="{Binding EmailText}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- STATUS -->
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource PawsBadgeBase}"
                                                                Background="{Binding StatusBadgeBackground}">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       Style="{StaticResource PawsBadgeTextBase}"
                                                                       Foreground="{Binding StatusBadgeForeground}"/>
                                                        </Border>

                                                        <!-- NEXT FOLLOW-UP -->
                                                        <TextBlock Grid.Column="2" Text="{Binding FollowUpText}"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- NOTES -->
                                                        <TextBlock Grid.Column="3" Text="{Binding NotesDisplay}"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource PawsTextSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- LAST CONTACTED -->
                                                        <TextBlock Grid.Column="4" Text="{Binding LastContactText}"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource PawsTextSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- ACTIONS -->
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Content="Update"
                                                                    Style="{StaticResource PawsSecondaryButton}"
                                                                    MinHeight="32" Padding="12,4" FontSize="12"
                                                                    Click="Update_Click" Tag="{Binding}"/>
                                                            <Button Content="Promos"
                                                                    Style="{StaticResource PawsPrimaryButton}"
                                                                    MinHeight="32" Padding="12,4" FontSize="12"
                                                                    Click="ShowPromos_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- =====================================================================
             FORM POPUP: sits on top of the whole page. Only one panel shows at a
             time. The overlay itself is shown/hidden from code (WatchPanel).
             ===================================================================== -->
        <Grid x:Name="FormOverlay"
              Grid.RowSpan="5"
              Margin="-32,-28,-32,0"
              Background="#8C1F2A44"
              Visibility="Collapsed">

            <!-- Edit retention notes -->
            <Border x:Name="EditFormPanel" Visibility="Collapsed"
                    Style="{StaticResource PawsCard}" Padding="24"
                    MaxWidth="600" Margin="24,96,24,24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="EditFormTitle" Text="Update Retention Notes"
                               Style="{StaticResource PawsSectionTitle}" TextWrapping="Wrap"/>
                    <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" Height="120"/>
                    <DatePicker x:Name="FollowUpDatePicker" Header="Next Follow-Up Date"/>
                    <TextBlock x:Name="DateClearedHint" Visibility="Collapsed"
                               Text="The follow-up date will be cleared when you press Save."
                               Style="{StaticResource PawsCaption}"
                               Foreground="{StaticResource PawsWarningBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Save" Style="{StaticResource PawsPrimaryButton}" Click="Save_Click"/>
                        <Button Content="Clear Follow-Up Date" Style="{StaticResource PawsSecondaryButton}" Click="ClearDate_Click"/>
                        <Button Content="Cancel" Style="{StaticResource PawsGhostButton}" Click="CancelForm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Promos panel: list + give-promo form for one customer -->
            <Border x:Name="PromosPanel" Visibility="Collapsed"
                    Style="{StaticResource PawsCard}" Padding="24"
                    MaxWidth="640" Margin="24,96,24,24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,0,12,0">
                        <TextBlock x:Name="PromosPanelTitle" Text="Promos"
                                   Style="{StaticResource PawsSectionTitle}" TextWrapping="Wrap"/>

                        <ItemsControl x:Name="PromosList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PawsBackgroundBrush}"
                                            BorderBrush="{StaticResource PawsBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding TitleText}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource PawsBadgeBase}"
                                                            Background="{Binding StatusBadgeBackground}">
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   Style="{StaticResource PawsBadgeTextBase}"
                                                                   Foreground="{Binding StatusBadgeForeground}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailText}"
                                                           Style="{StaticResource PawsCaption}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding RedeemedText}"
                                                           Style="{StaticResource PawsCaption}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding RedeemedVisibility}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Mark Redeemed"
                                                    Style="{StaticResource PawsSecondaryButton}"
                                                    MinHeight="32" Padding="12,4" FontSize="12"
                                                    Click="RedeemPromo_Click" Tag="{Binding}"
                                                    Visibility="{Binding RedeemVisibility}"
                                                    VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoPromosText" Text="No promos given yet."
                                   Style="{StaticResource PawsCaption}"/>

                        <Border BorderBrush="{StaticResource PawsBorderBrush}" BorderThickness="0,1,0,0"
                                Padding="0,16,0,0" Margin="0,8,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Give a New Promo" Style="{StaticResource PawsSectionTitle}"/>
                                <TextBox x:Name="PromoTitleBox" Header="Title"/>
                                <TextBox x:Name="PromoDescriptionBox" Header="Description (optional)" AcceptsReturn="True" Height="70"/>
                                <ComboBox x:Name="PromoDiscountTypeBox" Header="Discount Type" HorizontalAlignment="Stretch"
                                          SelectionChanged="PromoDiscountType_SelectionChanged">
                                    <ComboBoxItem Content="Percentage"/>
                                    <ComboBoxItem Content="Fixed Amount (PHP)"/>
                                    <ComboBoxItem Content="Other (non-monetary)"/>
                                </ComboBox>
                                <TextBox x:Name="PromoDiscountValueBox" Header="Discount Value"/>
                                <DatePicker x:Name="PromoExpiryDatePicker" Header="Expiry Date (optional)"/>
                                <CheckBox x:Name="PromoNoExpiryBox" Content="No expiry date" IsChecked="True"
                                          Checked="PromoNoExpiry_Changed" Unchecked="PromoNoExpiry_Changed"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Content="Give Promo" Style="{StaticResource PawsPrimaryButton}" Click="GivePromo_Click"/>
                                    <Button Content="Close" Style="{StaticResource PawsSecondaryButton}" Click="ClosePromosPanel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Messages shown inside the popup -->
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center"
                        MaxWidth="640" Margin="24,24,24,0" Spacing="8">
                <InfoBar x:Name="PopupErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
                <InfoBar x:Name="PopupSuccessBar" Severity="Success" IsOpen="False" IsClosable="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>