<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PAWS.winui.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <!-- The rounded square that holds a KPI card's icon -->
        <Style x:Key="KpiIconTile" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PawsBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32,24,32,32" Spacing="20">

                <!-- ================= HERO BANNER ================= -->
                <Border x:Name="HeroCard"
                        CornerRadius="16"
                        BorderBrush="{StaticResource PawsBorderBrush}"
                        BorderThickness="1"
                        MinHeight="150">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource PawsPrimarySoftColor}" Offset="0"/>
                            <GradientStop Color="{StaticResource PawsSurfaceColor}" Offset="0.45"/>
                            <GradientStop Color="{StaticResource PawsSurfaceColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Greeting -->
                        <StackPanel x:Name="HeroText" Grid.Column="0" Spacing="8"
                                    Margin="28,24,16,24" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon x:Name="GreetingIcon" Glyph="&#xE706;" FontSize="30"
                                          Foreground="{StaticResource PawsWarningBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="GreetingText" Style="{StaticResource PawsPageTitle}"
                                           FontSize="30" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="SubtitleText" Style="{StaticResource PawsCaption}" FontSize="14"
                                       TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                <Button x:Name="RefreshButton"
                                        Style="{StaticResource PawsSecondaryButton}"
                                        Click="Refresh_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Banner picture: Assets/dashboard-hero.png (dog, cat and tagline are part of the picture) -->
                        <Grid x:Name="HeroPicture" Grid.Column="1"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Image x:Name="HeroImage" Height="200" Stretch="Uniform">
                                <Image.Source>
                                    <BitmapImage UriSource="ms-appx:///Assets/dashboard-hero.png"
                                                 DecodePixelHeight="480"/>
                                </Image.Source>
                            </Image>

                            <!-- Soft fade on the picture's left edge so it blends into the card -->
                            <Border Width="120" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="ErrorBar"
                    Severity="Error"
                    IsOpen="False"
                    IsClosable="False"/>

                <!-- ================= KPI CARDS (the layout adapts to the window width from code) =================
                     Each card: icon on the left and mini chart on the right (top row), then the label and the
                     number at the full card width, so nothing is ever cut off. -->
                <Grid x:Name="KpiGrid" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Pets -->
                    <Border x:Name="KpiPets" Grid.Column="0" Style="{StaticResource PawsCard}" Padding="20">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource KpiIconTile}"
                                        Background="{StaticResource PawsPrimarySoftBrush}">
                                    <FontIcon Glyph="&#xE006;" FontSize="20" Foreground="{StaticResource PawsPrimaryBrush}"/>
                                </Border>
                                <Canvas x:Name="PetsSpark" Grid.Column="2" Width="110" Height="44" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Total Pets" Style="{StaticResource PawsCaption}"/>
                                <TextBlock x:Name="TotalPetsValue" Text="–" Style="{StaticResource PawsStatNumber}"/>
                            </StackPanel>
                            <TextBlock x:Name="PetsDelta" Text=" " FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PawsTextSecondaryBrush}"/>
                            <Border BorderBrush="{StaticResource PawsBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock x:Name="PetsFooter" Text="All pets in the system"
                                           Style="{StaticResource PawsCaption}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Applications -->
                    <Border x:Name="KpiApps" Grid.Column="1" Style="{StaticResource PawsCard}" Padding="20">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource KpiIconTile}"
                                        Background="{StaticResource PawsWarningSoftBrush}">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="20" Foreground="{StaticResource PawsWarningBrush}"/>
                                </Border>
                                <Canvas x:Name="AppsSpark" Grid.Column="2" Width="110" Height="44" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Pending Applications" Style="{StaticResource PawsCaption}"/>
                                <TextBlock x:Name="PendingApplicationsValue" Text="–" Style="{StaticResource PawsStatNumber}"/>
                            </StackPanel>
                            <TextBlock x:Name="AppsDelta" Text=" " FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PawsTextSecondaryBrush}"/>
                            <Border BorderBrush="{StaticResource PawsBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock x:Name="AppsFooter" Text="Awaiting review"
                                           Style="{StaticResource PawsCaption}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Customers -->
                    <Border x:Name="KpiCustomers" Grid.Column="2" Style="{StaticResource PawsCard}" Padding="20">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource KpiIconTile}"
                                        Background="{StaticResource PawsInfoSoftBrush}">
                                    <FontIcon Glyph="&#xE716;" FontSize="20" Foreground="{StaticResource PawsInfoBrush}"/>
                                </Border>

                                <!-- Retention split bar (overdue / due soon / on track / not scheduled) -->
                                <Border x:Name="RetentionBar" Grid.Column="2" Width="110" Height="10" CornerRadius="5"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource PawsHoverSurfaceBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="RetOverdueCol" Width="0*"/>
                                            <ColumnDefinition x:Name="RetDueSoonCol" Width="0*"/>
                                            <ColumnDefinition x:Name="RetOnTrackCol" Width="0*"/>
                                            <ColumnDefinition x:Name="RetNotSchedCol" Width="0*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Margin="0,0,1,0" CornerRadius="5" Background="{StaticResource PawsErrorBrush}"/>
                                        <Border Grid.Column="1" Margin="1,0,1,0" CornerRadius="5" Background="{StaticResource PawsWarningBrush}"/>
                                        <Border Grid.Column="2" Margin="1,0,1,0" CornerRadius="5" Background="{StaticResource PawsSuccessBrush}"/>
                                        <Border Grid.Column="3" Margin="1,0,0,0" CornerRadius="5" Background="{StaticResource PawsTextDisabledBrush}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Customers" Style="{StaticResource PawsCaption}"/>
                                <TextBlock x:Name="TotalCustomersValue" Text="–" Style="{StaticResource PawsStatNumber}"/>
                            </StackPanel>
                            <TextBlock x:Name="CustomersDelta" Text=" " FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PawsTextSecondaryBrush}"/>
                            <Border BorderBrush="{StaticResource PawsBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock x:Name="CustomersFooter" Text="Registered adopters"
                                           Style="{StaticResource PawsCaption}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Total Payments -->
                    <Border x:Name="KpiPayments" Grid.Column="3" Style="{StaticResource PawsCard}" Padding="20">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource KpiIconTile}"
                                        Background="{StaticResource PawsSuccessSoftBrush}">
                                    <FontIcon Glyph="&#xE825;" FontSize="20" Foreground="{StaticResource PawsSuccessBrush}"/>
                                </Border>
                                <Canvas x:Name="PaymentsSpark" Grid.Column="2" Width="110" Height="44" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Total Payments" Style="{StaticResource PawsCaption}"/>
                                <TextBlock x:Name="PaymentsValue" Text="–" Style="{StaticResource PawsStatNumber}"
                                           FontSize="26"/>
                            </StackPanel>
                            <TextBlock x:Name="PaymentsDelta" Text=" " FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PawsTextSecondaryBrush}"/>
                            <Border BorderBrush="{StaticResource PawsBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock x:Name="PaymentsFooter" Text="Completed payments only, assumed PHP"
                                           Style="{StaticResource PawsCaption}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= SECOND ROW: donut, pipeline, quick actions ================= -->
                <Grid x:Name="Row2Grid" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pet Status Overview -->
                    <Border x:Name="DonutCard" Grid.Column="0" Style="{StaticResource PawsCard}" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="OVERVIEW" Style="{StaticResource PawsOverline}"/>
                                <TextBlock Text="Pet Status Overview" Style="{StaticResource PawsSectionTitle}"/>
                            </StackPanel>

                            <TextBlock x:Name="DonutMessage" Visibility="Collapsed" Style="{StaticResource PawsCaption}"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="28" Padding="0,4,0,4">
                                    <Grid Width="180" Height="180">
                                        <Canvas x:Name="DonutCanvas" Width="180" Height="180"/>
                                        <Ellipse Width="104" Height="104" IsHitTestVisible="False"
                                                 Fill="{StaticResource PawsSurfaceBrush}"/>
                                        <StackPanel x:Name="DonutCenter" IsHitTestVisible="False"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="DonutCenterValue" Text="0"
                                                       FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource PawsTextPrimaryBrush}"/>
                                            <TextBlock Text="PETS" Style="{StaticResource PawsOverline}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="DonutLegend" Spacing="10" MinWidth="240" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Application Pipeline -->
                    <Border x:Name="PipelineCard" Grid.Column="1" Style="{StaticResource PawsCard}" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="OVERVIEW" Style="{StaticResource PawsOverline}"/>
                                <TextBlock Text="Application Pipeline" Style="{StaticResource PawsSectionTitle}"/>
                            </StackPanel>

                            <TextBlock x:Name="PipelineMessage" Visibility="Collapsed" Style="{StaticResource PawsCaption}"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                                <StackPanel x:Name="PipelineContainer" Orientation="Horizontal" Spacing="14"
                                            Height="240" VerticalAlignment="Bottom" Padding="0,4,0,4"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions -->
                    <Border x:Name="QuickCard" Grid.Column="2" Style="{StaticResource PawsCard}" Padding="20">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2" Margin="0,0,0,4">
                                <TextBlock Text="SHORTCUTS" Style="{StaticResource PawsOverline}"/>
                                <TextBlock Text="Quick Actions" Style="{StaticResource PawsSectionTitle}"/>
                            </StackPanel>

                            <Border x:Name="QaPets" Tag="Pets" Padding="14,12" CornerRadius="10"
                                    Background="{StaticResource PawsPrimaryBrush}"
                                    Tapped="QuickAction_Tapped"
                                    PointerEntered="Qa_PointerEntered" PointerExited="Qa_PointerExited">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="Manage Pets" FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="White"/>
                                </Grid>
                            </Border>

                            <Border x:Name="QaApplications" Tag="Applications" Padding="14,12" CornerRadius="10"
                                    Background="{StaticResource PawsBackgroundBrush}"
                                    Tapped="QuickAction_Tapped"
                                    PointerEntered="Qa_PointerEntered" PointerExited="Qa_PointerExited">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource PawsPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Review Applications" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PawsTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{StaticResource PawsTextSecondaryBrush}"/>
                                </Grid>
                            </Border>

                            <Border x:Name="QaPayments" Tag="Payments" Padding="14,12" CornerRadius="10"
                                    Background="{StaticResource PawsBackgroundBrush}"
                                    Tapped="QuickAction_Tapped"
                                    PointerEntered="Qa_PointerEntered" PointerExited="Qa_PointerExited">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE825;" FontSize="16" Foreground="{StaticResource PawsPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Payments" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PawsTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{StaticResource PawsTextSecondaryBrush}"/>
                                </Grid>
                            </Border>

                            <Border x:Name="QaRequests" Tag="CustomerService" Padding="14,12" CornerRadius="10"
                                    Background="{StaticResource PawsBackgroundBrush}"
                                    Tapped="QuickAction_Tapped"
                                    PointerEntered="Qa_PointerEntered" PointerExited="Qa_PointerExited">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8BD;" FontSize="16" Foreground="{StaticResource PawsPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Respond to Requests" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PawsTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{StaticResource PawsTextSecondaryBrush}"/>
                                </Grid>
                            </Border>

                            <Border x:Name="QaMedical" Tag="MedicalRecords" Padding="14,12" CornerRadius="10"
                                    Background="{StaticResource PawsBackgroundBrush}" Visibility="Collapsed"
                                    Tapped="QuickAction_Tapped"
                                    PointerEntered="Qa_PointerEntered" PointerExited="Qa_PointerExited">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7C3;" FontSize="16" Foreground="{StaticResource PawsPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Medical Records" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PawsTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{StaticResource PawsTextSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>