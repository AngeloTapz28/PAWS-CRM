<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PAWS.winui.Views.PetCategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PawsTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PawsComboBox}"/>
    </Page.Resources>

    <Grid Background="{StaticResource PawsBackgroundBrush}" Padding="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid x:Name="HeaderPanel" Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="MANAGEMENT" Style="{StaticResource PawsOverline}"/>
                <TextBlock Text="Pet Categories &amp; Breeds" Style="{StaticResource PawsPageTitle}"/>
                <TextBlock Text="Click a category to see and manage its breeds."
                           Style="{StaticResource PawsCaption}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"/>
                <Button Style="{StaticResource PawsSecondaryButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= MESSAGES ================= -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <!-- ================= TWO PANELS ================= -->
        <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,8,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: CATEGORIES ===== -->
            <Border x:Name="CategoriesCard" Grid.Column="0" Style="{StaticResource PawsCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="20,18,20,14" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Categories" Style="{StaticResource PawsSectionTitle}"/>
                            <TextBlock x:Name="CategoryCountText" Text=" " Style="{StaticResource PawsCaption}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PawsPrimaryButton}"
                                MinHeight="36" Padding="14,6" Click="AddCategory_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Add Category" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="CategoriesEmpty" Visibility="Collapsed"
                                        Spacing="10" HorizontalAlignment="Center" Margin="0,40,0,40">
                                <Image Source="ms-appx:///Assets/paws-icon.png" Width="56" Height="56" Opacity="0.35"/>
                                <TextBlock Text="No categories yet" Style="{StaticResource PawsSectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Use Add Category to create one." Style="{StaticResource PawsCaption}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl x:Name="CategoriesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="20,12"
                                                Background="{Binding RowBackground}"
                                                BorderBrush="{StaticResource PawsBorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Loaded="CategoryRowItem_Loaded"
                                                Tapped="CategoryRow_Tapped" Tag="{Binding}">
                                            <Border.BackgroundTransition>
                                                <BrushTransition Duration="0:0:0.2"/>
                                            </Border.BackgroundTransition>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding CategoryName}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{Binding NameBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="1" Style="{StaticResource PawsBadgeBase}"
                                                        Background="{Binding StatusBadgeBackground}">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               Style="{StaticResource PawsBadgeTextBase}"
                                                               Foreground="{Binding StatusBadgeForeground}"/>
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Deactivate" Click="DeactivateCategory_Click" Tag="{Binding}"
                                                            Style="{StaticResource PawsGhostButton}"
                                                            Foreground="{StaticResource PawsErrorBrush}"
                                                            MinHeight="32" Padding="10,4" FontSize="12"
                                                            Visibility="{Binding DeactivateVisibility}"/>
                                                    <Button Content="Activate" Click="ActivateCategory_Click" Tag="{Binding}"
                                                            Style="{StaticResource PawsGhostButton}"
                                                            Foreground="{StaticResource PawsSuccessBrush}"
                                                            MinHeight="32" Padding="10,4" FontSize="12"
                                                            Visibility="{Binding ActivateVisibility}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== RIGHT: BREEDS ===== -->
            <Border x:Name="BreedsCard" Grid.Column="1" Style="{StaticResource PawsCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="20,18,20,14" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="BreedsTitle" Text="Breeds" Style="{StaticResource PawsSectionTitle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="BreedCountText" Text=" " Style="{StaticResource PawsCaption}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PawsPrimaryButton}"
                                MinHeight="36" Padding="14,6" Click="AddBreed_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Add Breed" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Shown until a category is clicked -->
                            <StackPanel x:Name="BreedsPrompt" Spacing="10" HorizontalAlignment="Center" Margin="0,40,0,40">
                                <FontIcon Glyph="&#xE76B;" FontSize="28"
                                          Foreground="{StaticResource PawsTextDisabledBrush}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Select a category" Style="{StaticResource PawsSectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Its breeds will appear here." Style="{StaticResource PawsCaption}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Shown while breeds are loading -->
                            <TextBlock x:Name="BreedsLoading" Text="Loading breeds..." Visibility="Collapsed"
                                       Style="{StaticResource PawsCaption}" HorizontalAlignment="Center" Margin="0,40,0,40"/>

                            <!-- Shown when the selected category has no breeds -->
                            <StackPanel x:Name="BreedsEmpty" Visibility="Collapsed"
                                        Spacing="10" HorizontalAlignment="Center" Margin="0,40,0,40">
                                <Image Source="ms-appx:///Assets/paws-icon.png" Width="56" Height="56" Opacity="0.35"/>
                                <TextBlock Text="No breeds in this category" Style="{StaticResource PawsSectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Use Add Breed to create one." Style="{StaticResource PawsCaption}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl x:Name="BreedsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="20,12"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource PawsBorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Loaded="BreedRow_Loaded"
                                                PointerEntered="Row_PointerEntered"
                                                PointerExited="Row_PointerExited">
                                            <Border.BackgroundTransition>
                                                <BrushTransition Duration="0:0:0.12"/>
                                            </Border.BackgroundTransition>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding BreedName}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="1" Style="{StaticResource PawsBadgeBase}"
                                                        Background="{Binding StatusBadgeBackground}">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               Style="{StaticResource PawsBadgeTextBase}"
                                                               Foreground="{Binding StatusBadgeForeground}"/>
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Deactivate" Click="DeactivateBreed_Click" Tag="{Binding}"
                                                            Style="{StaticResource PawsGhostButton}"
                                                            Foreground="{StaticResource PawsErrorBrush}"
                                                            MinHeight="32" Padding="10,4" FontSize="12"
                                                            Visibility="{Binding DeactivateVisibility}"/>
                                                    <Button Content="Activate" Click="ActivateBreed_Click" Tag="{Binding}"
                                                            Style="{StaticResource PawsGhostButton}"
                                                            Foreground="{StaticResource PawsSuccessBrush}"
                                                            MinHeight="32" Padding="10,4" FontSize="12"
                                                            Visibility="{Binding ActivateVisibility}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- =====================================================================
             FORM POPUP: sits on top of the whole page. Only one panel shows at a
             time. The overlay itself is shown/hidden from code (WatchPanel).
             ===================================================================== -->
        <Grid x:Name="FormOverlay"
              Grid.RowSpan="3"
              Margin="-32,-28,-32,0"
              Background="#8C1F2A44"
              Visibility="Collapsed">

            <!-- Category form -->
            <Border x:Name="CategoryFormPanel" Visibility="Collapsed"
                    Style="{StaticResource PawsCard}" Padding="24"
                    MaxWidth="560" Margin="24,96,24,24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="CategoryFormTitle" Text="Add Category" Style="{StaticResource PawsSectionTitle}"/>
                    <TextBox x:Name="CategoryNameBox" Header="Category Name"/>
                    <TextBox x:Name="CategoryDescriptionBox" Header="Description (optional)"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="SaveCategoryButton" Content="Save" Style="{StaticResource PawsPrimaryButton}" Click="SaveCategory_Click"/>
                        <Button Content="Cancel" Style="{StaticResource PawsSecondaryButton}" Click="CancelCategoryForm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Breed form -->
            <Border x:Name="BreedFormPanel" Visibility="Collapsed"
                    Style="{StaticResource PawsCard}" Padding="24"
                    MaxWidth="560" Margin="24,96,24,24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="BreedFormTitle" Text="Add Breed" Style="{StaticResource PawsSectionTitle}"/>
                    <ComboBox x:Name="BreedCategoryBox" Header="Category" HorizontalAlignment="Stretch"
                              DisplayMemberPath="CategoryName"/>
                    <TextBox x:Name="BreedNameBox" Header="Breed Name"/>
                    <TextBox x:Name="BreedDescriptionBox" Header="Description (optional)"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="SaveBreedButton" Content="Save" Style="{StaticResource PawsPrimaryButton}" Click="SaveBreed_Click"/>
                        <Button Content="Cancel" Style="{StaticResource PawsSecondaryButton}" Click="CancelBreedForm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Error bar shown inside the popup -->
            <InfoBar x:Name="PopupErrorBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Center"
                     MaxWidth="560"
                     Margin="24,24,24,0"/>
        </Grid>
    </Grid>
</Page>