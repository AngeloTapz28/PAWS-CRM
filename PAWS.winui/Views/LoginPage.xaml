<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PAWS.winui.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- Constant, gentle logo animation (started from code when the page loads) -->
        <Storyboard x:Name="LogoAnimation">

            <!-- BACKGROUND: the picture fades in once -->
            <DoubleAnimation Storyboard.TargetName="BgImage"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:1.0"/>

            <!-- FLOAT: the whole logo drifts up and down -->
            <DoubleAnimation Storyboard.TargetName="FloatTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-14"
                             Duration="0:0:2.2"
                             AutoReverse="True"
                             RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- WAVE: the paw icon tilts left and right -->
            <DoubleAnimation Storyboard.TargetName="WaveTransform"
                             Storyboard.TargetProperty="Angle"
                             From="-6" To="6"
                             Duration="0:0:2.6"
                             AutoReverse="True"
                             RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- PULSE: a soft ring grows out from behind the logo and fades -->
            <DoubleAnimation Storyboard.TargetName="PulseScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.5"
                             Duration="0:0:2.8"
                             RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.5"
                             Duration="0:0:2.8"
                             RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="0"
                             Duration="0:0:2.8"
                             RepeatBehavior="Forever"/>
        </Storyboard>
    </Page.Resources>

    <Grid Background="{StaticResource PawsSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="320"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: BRAND PANEL ================= -->
        <Grid Grid.Column="0" Background="{StaticResource PawsSlateBrush}">

            <!-- Background picture: Assets/login-bg.png -->
            <Image x:Name="BgImage"
                   Source="ms-appx:///Assets/login-bg.png"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>

            <!-- Light navy layer so the white text stays easy to read -->
            <Border Background="#262A3A5C" IsHitTestVisible="False"/>

            <StackPanel
                MaxWidth="400"
                Padding="40"
                Spacing="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- Animated logo: pulse ring + coral circle + waving paw, floating as one -->
                <Grid x:Name="LogoHolder"
                      Width="120"
                      Height="120"
                      HorizontalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="FloatTransform"/>
                    </Grid.RenderTransform>

                    <!-- Pulse ring (behind the circle) -->
                    <Ellipse x:Name="PulseRing"
                             Width="120"
                             Height="120"
                             Stroke="{StaticResource PawsPrimaryBrush}"
                             StrokeThickness="2"
                             Opacity="0"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseScale"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Coral circle with the white paw icon -->
                    <Border Width="120"
                            Height="120"
                            CornerRadius="60"
                            Background="{StaticResource PawsPrimaryBrush}">
                        <Image x:Name="LogoImage"
                               Source="ms-appx:///Assets/paws-icon-white.png"
                               Width="68"
                               Height="68"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="WaveTransform"/>
                            </Image.RenderTransform>
                        </Image>
                    </Border>
                </Grid>

                <TextBlock
                    Text="Welcome Back!"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>

                <TextBlock
                    Text="Sign in to your PAWS account and continue your pet adoption journey."
                    FontSize="14"
                    Foreground="White"
                    Opacity="0.75"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"/>

                <!-- Plain feature lines (static text, not data) -->
                <StackPanel Spacing="14" Margin="0,16,0,0">

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#1FFFFFFF">
                            <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="White"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Browse pets waiting for a home"
                                   Foreground="White" Opacity="0.85" FontSize="14"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#1FFFFFFF">
                            <FontIcon Glyph="&#xE7C3;" FontSize="16" Foreground="White"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Track every adoption application"
                                   Foreground="White" Opacity="0.85" FontSize="14"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#1FFFFFFF">
                            <FontIcon Glyph="&#xE715;" FontSize="16" Foreground="White"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Stay updated with notifications"
                                   Foreground="White" Opacity="0.85" FontSize="14"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>

                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= RIGHT: SIGN-IN FORM ================= -->
        <ScrollViewer
            Grid.Column="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                MaxWidth="400"
                Padding="32,40"
                Spacing="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- Fade + slide-up when the page opens -->
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <Image
                    Source="ms-appx:///Assets/paws-logo-full.png"
                    Height="130"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"/>

                <StackPanel Spacing="4" Margin="0,8,0,8">
                    <TextBlock
                        Text="Sign In"
                        Style="{StaticResource PawsPageTitle}"/>
                    <TextBlock
                        Text="Enter your organization and credentials to access your account."
                        Style="{StaticResource PawsCaption}"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <InfoBar
                    x:Name="InfoMessageBar"
                    Severity="Success"
                    IsOpen="False"
                    IsClosable="False"/>

                <TextBox
                    x:Name="CompanyCodeBox"
                    Header="Company Code"
                    PlaceholderText="e.g. PAWS-A"
                    Style="{StaticResource PawsTextBox}"/>

                <TextBox
                    x:Name="EmailBox"
                    Header="Email"
                    PlaceholderText="you@example.com"
                    Style="{StaticResource PawsTextBox}"/>

                <PasswordBox
                    x:Name="PasswordInput"
                    Header="Password"
                    PlaceholderText="Password"
                    Style="{StaticResource PawsPasswordBox}"/>

                <Button
                    x:Name="LoginButton"
                    Content="Sign in"
                    Style="{StaticResource PawsPrimaryButton}"
                    HorizontalAlignment="Stretch"
                    MinHeight="44"
                    Margin="0,6,0,0"
                    Click="Login_Click"/>

                <ProgressRing
                    x:Name="Busy"
                    IsActive="False"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"/>

                <InfoBar
                    x:Name="ErrorBar"
                    Severity="Error"
                    IsOpen="False"
                    IsClosable="False"/>

                <Border
                    Height="1"
                    Background="{StaticResource PawsBorderBrush}"
                    Margin="0,8,0,4"/>

                <HyperlinkButton
                    Content="Don't have an account? Register"
                    Foreground="{StaticResource PawsPrimaryBrush}"
                    HorizontalAlignment="Center"
                    Click="Register_Click"/>

                <HyperlinkButton
                    Content="Platform sign-in (Super Admin)"
                    Foreground="{StaticResource PawsTextSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Click="PlatformLogin_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>