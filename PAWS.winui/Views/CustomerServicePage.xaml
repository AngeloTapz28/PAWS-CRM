<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PAWS.winui.Views.CustomerServicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PawsTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PawsComboBox}"/>
    </Page.Resources>

    <Grid Background="{StaticResource PawsBackgroundBrush}" Padding="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid x:Name="HeaderPanel" Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="OPERATIONS" Style="{StaticResource PawsOverline}"/>
                <TextBlock x:Name="PageTitle" Text="Customer Service" Style="{StaticResource PawsPageTitle}"/>
                <TextBlock x:Name="ResultCountText" Text=" " Style="{StaticResource PawsCaption}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"/>
                <Button x:Name="RefreshButton" Style="{StaticResource PawsSecondaryButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NewRequestButton" Style="{StaticResource PawsPrimaryButton}" Click="NewRequest_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="New Request"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= TOOLBAR ================= -->
        <Border x:Name="ToolbarCard" Grid.Row="1" Style="{StaticResource PawsCard}" Padding="16" Margin="0,20,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="StatusFilterBox" Grid.Column="0" Header="Status" Width="190"
                          SelectionChanged="Filter_Changed"/>
                <ComboBox x:Name="TypeFilterBox" Grid.Column="1" Header="Type" Width="190"
                          SelectionChanged="Filter_Changed"/>
                <Button Grid.Column="2" Style="{StaticResource PawsGhostButton}"
                        VerticalAlignment="Bottom"
                        Content="Reset" Click="ResetFilters_Click"/>
            </Grid>
        </Border>

        <!-- ================= MESSAGES ================= -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <!-- ================= EMPTY STATE + REQUEST CARDS ================= -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel Spacing="12" Padding="0,8,0,32">

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            Spacing="10" HorizontalAlignment="Center" Margin="0,48,0,0">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="16"/>
                        </TransitionCollection>
                    </StackPanel.Transitions>
                    <Image Source="ms-appx:///Assets/paws-icon.png" Width="72" Height="72" Opacity="0.35"/>
                    <TextBlock x:Name="EmptyTitleText" Text="No requests found"
                               Style="{StaticResource PawsSectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHintText" Text=" "
                               Style="{StaticResource PawsCaption}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Grid x:Name="ListHost">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.2"/>
                    </Grid.OpacityTransition>

                    <ItemsControl x:Name="RequestsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PawsCard}" Margin="0,0,0,12"
                                        Loaded="Card_Loaded"
                                        PointerEntered="Card_PointerEntered"
                                        PointerExited="Card_PointerExited">

                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="8">

                                            <!-- Badges + date -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Style="{StaticResource PawsBadgeBase}"
                                                        Background="{Binding TypeBadgeBackground}">
                                                    <TextBlock Text="{Binding TypeLabel}"
                                                               Style="{StaticResource PawsBadgeTextBase}"
                                                               Foreground="{Binding TypeBadgeForeground}"/>
                                                </Border>
                                                <Border Style="{StaticResource PawsBadgeBase}"
                                                        Background="{Binding StatusBadgeBackground}">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               Style="{StaticResource PawsBadgeTextBase}"
                                                               Foreground="{Binding StatusBadgeForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding DateText}"
                                                           Style="{StaticResource PawsCaption}"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>

                                            <!-- Subject -->
                                            <TextBlock Text="{Binding SubjectText}"
                                                       FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>

                                            <!-- From (Staff / Admin only) -->
                                            <TextBlock Text="{Binding FromText}"
                                                       Style="{StaticResource PawsCaption}"
                                                       Visibility="{Binding FromVisibility}"/>

                                            <!-- Message -->
                                            <TextBlock Text="{Binding MessageText}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>

                                            <!-- Staff response -->
                                            <Border Background="{StaticResource PawsSuccessSoftBrush}"
                                                    CornerRadius="8" Padding="14,10" Margin="0,4,0,0"
                                                    Visibility="{Binding ResponseVisibility}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="STAFF RESPONSE" Style="{StaticResource PawsOverline}"
                                                               Foreground="{StaticResource PawsSuccessBrush}"/>
                                                    <TextBlock Text="{Binding ResponseText}"
                                                               FontSize="14"
                                                               Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Top">
                                            <Button Content="Respond"
                                                    Style="{StaticResource PawsPrimaryButton}"
                                                    MinHeight="34" Padding="14,5" FontSize="13"
                                                    Click="Respond_Click" Tag="{Binding}"
                                                    Visibility="{Binding RespondVisibility}"/>
                                            <Button Content="Close"
                                                    Style="{StaticResource PawsSecondaryButton}"
                                                    MinHeight="34" Padding="14,5" FontSize="13"
                                                    Click="Close_Click" Tag="{Binding}"
                                                    Visibility="{Binding CloseVisibility}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- =====================================================================
             FORM POPUP: sits on top of the whole page. Only one panel shows at a
             time. The overlay itself is shown/hidden from code (WatchPanel).
             ===================================================================== -->
        <Grid x:Name="FormOverlay"
              Grid.RowSpan="4"
              Margin="-32,-28,-32,0"
              Background="#8C1F2A44"
              Visibility="Collapsed">

            <!-- New request form (Adopter) -->
            <Border x:Name="NewFormPanel" Visibility="Collapsed"
                    Style="{StaticResource PawsCard}" Padding="24"
                    MaxWidth="600" Margin="24,96,24,24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="Submit a Request" Style="{StaticResource PawsSectionTitle}"/>
                    <TextBlock Text="Send us an inquiry, a complaint or feedback. Our staff will respond here."
                               Style="{StaticResource PawsCaption}" TextWrapping="Wrap"/>
                    <ComboBox x:Name="NewTypeBox" Header="Type" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Inquiry"/>
                        <ComboBoxItem Content="Complaint"/>
                        <ComboBoxItem Content="Feedback"/>
                    </ComboBox>
                    <TextBox x:Name="NewSubjectBox" Header="Subject"/>
                    <TextBox x:Name="NewMessageBox" Header="Message" AcceptsReturn="True" Height="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Submit" Style="{StaticResource PawsPrimaryButton}" Click="SubmitNew_Click"/>
                        <Button Content="Cancel" Style="{StaticResource PawsSecondaryButton}" Click="CancelNewForm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Respond form (Staff / Admin) -->
            <Border x:Name="RespondFormPanel" Visibility="Collapsed"
                    Style="{StaticResource PawsCard}" Padding="24"
                    MaxWidth="600" Margin="24,96,24,24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="RespondFormTitle" Text="Respond" Style="{StaticResource PawsSectionTitle}"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="RespondTextBox" Header="Response" AcceptsReturn="True" Height="120"/>
                    <ComboBox x:Name="RespondStatusBox" Header="New Status" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="In Progress"/>
                        <ComboBoxItem Content="Resolved"/>
                        <ComboBoxItem Content="Closed"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Save Response" Style="{StaticResource PawsPrimaryButton}" Click="SaveResponse_Click"/>
                        <Button Content="Cancel" Style="{StaticResource PawsSecondaryButton}" Click="CancelRespondForm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Error bar shown inside the popup -->
            <InfoBar x:Name="PopupErrorBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Center"
                     MaxWidth="600"
                     Margin="24,24,24,0"/>
        </Grid>
    </Grid>
</Page>