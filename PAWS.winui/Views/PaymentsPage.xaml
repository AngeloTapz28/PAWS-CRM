<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PAWS.winui.Views.PaymentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PawsTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PawsComboBox}"/>
    </Page.Resources>

    <Grid Background="{StaticResource PawsBackgroundBrush}" Padding="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid x:Name="HeaderPanel" Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="OPERATIONS" Style="{StaticResource PawsOverline}"/>
                <TextBlock x:Name="PageTitle" Text="Payments" Style="{StaticResource PawsPageTitle}"/>
                <TextBlock x:Name="SummaryText" Text=" " Style="{StaticResource PawsCaption}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"/>
                <Button x:Name="RefreshButton" Style="{StaticResource PawsSecondaryButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AddPaymentButton" Style="{StaticResource PawsPrimaryButton}"
                        Click="AddPayment_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Record Payment"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= TOOLBAR ================= -->
        <Border x:Name="ToolbarCard" Grid.Row="1" Style="{StaticResource PawsCard}" Padding="16" Margin="0,20,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="StatusFilterBox" Grid.Column="0" Header="Status" Width="200"
                          SelectionChanged="Filter_Changed"/>
                <Button Grid.Column="1" Style="{StaticResource PawsGhostButton}"
                        VerticalAlignment="Bottom"
                        Content="Reset" Click="ResetFilters_Click"/>
            </Grid>
        </Border>

        <!-- ================= MESSAGES ================= -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <!-- ================= EMPTY STATE + TABLE ================= -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel Spacing="16" Padding="0,8,0,32">

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            Spacing="10" HorizontalAlignment="Center" Margin="0,48,0,0">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="16"/>
                        </TransitionCollection>
                    </StackPanel.Transitions>
                    <Image Source="ms-appx:///Assets/paws-icon.png" Width="72" Height="72" Opacity="0.35"/>
                    <TextBlock x:Name="EmptyTitleText" Text="No payments found"
                               Style="{StaticResource PawsSectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHintText" Text=" "
                               Style="{StaticResource PawsCaption}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="TableCard" Style="{StaticResource PawsCard}" Padding="0,0,0,8">
                    <StackPanel>
                        <StackPanel Padding="24,20,24,14" Spacing="2">
                            <TextBlock x:Name="TableTitle" Text="All Payments" Style="{StaticResource PawsSectionTitle}"/>
                            <TextBlock x:Name="TotalText" Text=" " Style="{StaticResource PawsCaption}"/>
                        </StackPanel>

                        <ScrollViewer x:Name="TableScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Disabled"
                                      SizeChanged="TableScroll_SizeChanged">
                            <Grid x:Name="TableGrid" MinWidth="1160">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row -->
                                <Grid Grid.Row="0" Padding="24,10"
                                      Background="{StaticResource PawsBackgroundBrush}"
                                      BorderBrush="{StaticResource PawsBorderBrush}"
                                      BorderThickness="0,1,0,1"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="REFERENCE" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="2" Text="APPLICATION" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="3" Text="AMOUNT" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="4" Text="METHOD" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="6" Text="DATE" Style="{StaticResource PawsOverline}"/>
                                    <TextBlock Grid.Column="7" Text="ACTION" Style="{StaticResource PawsOverline}" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Data rows -->
                                <Grid Grid.Row="1" x:Name="ListHost">
                                    <Grid.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.2"/>
                                    </Grid.OpacityTransition>

                                    <ItemsControl x:Name="PaymentsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="24,12"
                                                        Background="Transparent"
                                                        BorderBrush="{StaticResource PawsBorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Loaded="Row_Loaded"
                                                        PointerEntered="Row_PointerEntered"
                                                        PointerExited="Row_PointerExited">
                                                    <Border.BackgroundTransition>
                                                        <BrushTransition Duration="0:0:0.12"/>
                                                    </Border.BackgroundTransition>

                                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                                        <!-- These widths MUST match the header row above -->
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="105"/>
                                                            <ColumnDefinition Width="115"/>
                                                            <ColumnDefinition Width="240"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- REFERENCE -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                   Text="{Binding ReferenceText}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PawsPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- TYPE -->
                                                        <Border Grid.Row="0" Grid.Column="1"
                                                                Style="{StaticResource PawsBadgeBase}"
                                                                Background="{Binding TypeBadgeBackground}">
                                                            <TextBlock Text="{Binding TypeLabel}"
                                                                       Style="{StaticResource PawsBadgeTextBase}"
                                                                       Foreground="{Binding TypeBadgeForeground}"/>
                                                        </Border>

                                                        <!-- APPLICATION -->
                                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                                   Text="{Binding ApplicationText}"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- AMOUNT -->
                                                        <TextBlock Grid.Row="0" Grid.Column="3"
                                                                   Text="{Binding AmountText}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="{StaticResource PawsTextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- METHOD -->
                                                        <TextBlock Grid.Row="0" Grid.Column="4"
                                                                   Text="{Binding MethodText}"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource PawsTextSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- STATUS -->
                                                        <Border Grid.Row="0" Grid.Column="5"
                                                                Style="{StaticResource PawsBadgeBase}"
                                                                Background="{Binding StatusBadgeBackground}">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       Style="{StaticResource PawsBadgeTextBase}"
                                                                       Foreground="{Binding StatusBadgeForeground}"/>
                                                        </Border>

                                                        <!-- DATE (created, plus paid date when there is one) -->
                                                        <StackPanel Grid.Row="0" Grid.Column="6" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{Binding CreatedText}"
                                                                       Style="{StaticResource PawsCaption}" FontSize="13"/>
                                                            <TextBlock Text="{Binding PaidText}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource PawsSuccessBrush}"
                                                                       Visibility="{Binding PaidVisibility}"/>
                                                        </StackPanel>

                                                        <!-- ACTIONS -->
                                                        <StackPanel Grid.Row="0" Grid.Column="7"
                                                                    Orientation="Horizontal" Spacing="6"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Content="Mark Completed"
                                                                    Style="{StaticResource PawsPrimaryButton}"
                                                                    MinHeight="32" Padding="12,4" FontSize="12"
                                                                    Click="MarkCompleted_Click" Tag="{Binding}"
                                                                    Visibility="{Binding CompleteVisibility}"/>
                                                            <Button Content="Mark Failed"
                                                                    Style="{StaticResource PawsGhostButton}"
                                                                    Foreground="{StaticResource PawsErrorBrush}"
                                                                    MinHeight="32" Padding="10,4" FontSize="12"
                                                                    Click="MarkFailed_Click" Tag="{Binding}"
                                                                    Visibility="{Binding FailVisibility}"/>
                                                            <Button Content="Refund"
                                                                    Style="{StaticResource PawsSecondaryButton}"
                                                                    MinHeight="32" Padding="12,4" FontSize="12"
                                                                    Click="Refund_Click" Tag="{Binding}"
                                                                    Visibility="{Binding RefundVisibility}"/>
                                                        </StackPanel>

                                                        <!-- Notes (only when present) -->
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8"
                                                                   Text="{Binding NotesText}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource PawsTextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding NotesVisibility}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- =====================================================================
             FORM POPUP: sits on top of the whole page. The overlay itself is
             shown/hidden from code (WatchPanel).
             ===================================================================== -->
        <Grid x:Name="FormOverlay"
              Grid.RowSpan="4"
              Margin="-32,-28,-32,0"
              Background="#8C1F2A44"
              Visibility="Collapsed">

            <!-- Record payment form -->
            <Border x:Name="FormPanel" Visibility="Collapsed"
                    Style="{StaticResource PawsCard}" Padding="24"
                    MaxWidth="600" Margin="24,96,24,24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,0,12,0">
                        <TextBlock Text="Record a Payment" Style="{StaticResource PawsSectionTitle}"/>
                        <ComboBox x:Name="ApplicationBox" Header="Application" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="DisplayText" MaxDropDownHeight="400"
                                  SelectionChanged="ApplicationBox_SelectionChanged"/>

                        <!-- Filled in automatically, cannot be edited -->
                        <TextBox x:Name="TypeBox" Header="Type" IsReadOnly="True" Text="Adoption Fee"/>
                        <TextBox x:Name="AmountBox" Header="Amount (PHP)" IsReadOnly="True"/>
                        <TextBlock x:Name="AmountHintText" Text=" "
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource PawsTextSecondaryBrush}"/>

                        <ComboBox x:Name="MethodBox" Header="Method" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Cash"/>
                            <ComboBoxItem Content="GCash"/>
                            <ComboBoxItem Content="Maya"/>
                            <ComboBoxItem Content="Bank Transfer"/>
                            <ComboBoxItem Content="Credit Card"/>
                        </ComboBox>
                        <TextBox x:Name="NotesBox" Header="Notes (optional)" AcceptsReturn="True" Height="80"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="Save" Style="{StaticResource PawsPrimaryButton}" Click="Save_Click"/>
                            <Button Content="Cancel" Style="{StaticResource PawsSecondaryButton}" Click="CancelForm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Error bar shown inside the popup -->
            <InfoBar x:Name="PopupErrorBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Center"
                     MaxWidth="600"
                     Margin="24,24,24,0"/>
        </Grid>
    </Grid>
</Page>