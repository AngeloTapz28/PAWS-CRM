<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PAWS.winui.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="0,32">
            <StackPanel
                Spacing="14"
                Width="360"
                HorizontalAlignment="Center">

                <TextBlock
                    Text="Create your PAWS account"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="For adopters only. Staff and administrator accounts are created by your organization."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>

                <TextBox
                    x:Name="CompanyCodeBox"
                    Header="Company Code"
                    PlaceholderText="e.g. PAWS-A"/>

                <TextBox
                    x:Name="FullNameBox"
                    Header="Full Name"
                    PlaceholderText="Juan Dela Cruz"/>

                <TextBox
                    x:Name="EmailBox"
                    Header="Email"
                    PlaceholderText="you@example.com"/>

                <TextBox
                    x:Name="PhoneBox"
                    Header="Phone (optional)"
                    PlaceholderText="09171234567"/>

                <PasswordBox
                    x:Name="PasswordInput"
                    Header="Password"
                    PlaceholderText="At least 8 characters"/>

                <PasswordBox
                    x:Name="ConfirmPasswordInput"
                    Header="Confirm Password"
                    PlaceholderText="Retype your password"/>

                <Button
                    x:Name="RegisterButton"
                    Content="Register"
                    HorizontalAlignment="Stretch"
                    Click="Register_Click"/>

                <ProgressRing
                    x:Name="Busy"
                    IsActive="False"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"/>

                <InfoBar
                    x:Name="ErrorBar"
                    Severity="Error"
                    IsOpen="False"
                    IsClosable="False"/>

                <HyperlinkButton
                    Content="Already have an account? Sign in"
                    HorizontalAlignment="Center"
                    Click="BackToLogin_Click"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>